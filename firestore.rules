rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // メール確認済みのログイン。Google ログインは email_verified が true になる。
    // 未確認の Email/Password で editor のメールを名乗るトークンはここで落とす。
    function isVerifiedAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    // hihaho 編集者 = @splineglobal.com ドメイン or 許可リストのGoogleアカウント
    // （hihaho-admin / hihaho-kb-admin / hihaho-material 共通）
    function isHihahoEditor() {
      return isVerifiedAccount() && (
        request.auth.token.email.matches('.*@splineglobal[.]com') ||
        request.auth.token.email == 'junpei.omote@gmail.com'
      );
    }

    // プレイリスト：読み取りは公開（hihaho-view / hihaho-player が匿名で読む）・書き込みは編集者のみ
    match /playlists/{id} {
      allow read: if true;
      allow write: if isHihahoEditor();
    }

    // サムネイルメタ：読み取りは公開・書き込みは編集者のみ（hihaho-admin からのみ更新）
    match /video_meta/{id} {
      allow read: if true;
      allow write: if isHihahoEditor();
    }

    // Flight Strip TODO: ユーザー自身のデータのみ（tasks + meta 配下すべて）
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Flight Strip TODO Analytics
    // 安定版・開発版とも、ログインユーザーが自分のセッション／イベントを create するだけ。
    // 文書に uid は無く uidHash だけなので、本人以外の改ざんは update/delete 禁止で止める。
    // 読み取りは編集者のみ（analytics.html / 開発版 ADMIN の一覧）。
    // 残リスク: 確認済みユーザーなら誰でも偽の計測を追記できる（クライアントが uid を書いていない）。
    function fstAnalyticsCreateOk() {
      let d = request.resource.data;
      return isVerifiedAccount()
        && d.keys().hasAll(['uidHash', 'date', 'version', 'build', 'createdAt'])
        && d.keys().hasOnly(['uidHash', 'date', 'month', 'hour', 'dow', 'version', 'build', 'device', 'type', 'createdAt'])
        && d.uidHash is string && d.uidHash.size() > 0 && d.uidHash.size() <= 32
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.version is string && d.version.size() <= 40
        && d.build is string && d.build.size() <= 32
        && d.createdAt == request.time
        && (!('month' in d) || (d.month is string && d.month.matches('^[0-9]{4}-[0-9]{2}$')))
        && (!('hour' in d) || (d.hour is int && d.hour >= 0 && d.hour <= 23))
        && (!('dow' in d) || (d.dow is int && d.dow >= 0 && d.dow <= 6))
        && (!('device' in d) || (d.device is string && d.device.size() <= 16))
        && (!('type' in d) || d.type in ['task_created', 'task_completed']);
    }
    match /fst_analytics/{docId} {
      allow read: if isHihahoEditor();
      allow create: if fstAnalyticsCreateOk();
      allow update, delete: if false;
    }

    // フィードバック: 本人が新規作成し、自動返信フラグだけ自分で更新できる。
    // 受信箱の一覧と返信ステータスの更新は編集者のみ。他人の本文の改ざん・削除は不可。
    function fstFeedbackCreateOk(docId) {
      let d = request.resource.data;
      return isVerifiedAccount()
        && docId.matches('^FB_[0-9]{4,8}$')
        && d.keys().hasOnly(['fbId', 'subject', 'email', 'message', 'build', 'uid', 'status', 'replySent', 'createdAt'])
        && d.fbId == docId
        && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 100
        && d.email is string && d.email.size() <= 320
        && d.message is string && d.message.size() > 0 && d.message.size() <= 200
        && d.build is string && d.build.size() <= 32
        && d.uid == request.auth.uid
        && d.status == 'new'
        && d.replySent == false
        && d.createdAt == request.time;
    }
    function fstFeedbackOwnerAck() {
      return isVerifiedAccount()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replySent'])
        && request.resource.data.replySent == true;
    }
    function fstFeedbackEditorUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isHihahoEditor()
        && changed.hasOnly(['status', 'replyText', 'repliedAt'])
        && request.resource.data.status in ['new', 'read', 'replied']
        && (!changed.hasAny(['repliedAt'])
            || request.resource.data.repliedAt == null
            || request.resource.data.repliedAt == request.time)
        && (!('replyText' in request.resource.data)
            || request.resource.data.replyText == null
            || (request.resource.data.replyText is string && request.resource.data.replyText.size() <= 8000));
    }
    match /fst_feedback/{docId} {
      allow read: if isHihahoEditor();
      allow create: if fstFeedbackCreateOk(docId);
      allow update: if fstFeedbackOwnerAck() || fstFeedbackEditorUpdate();
      allow delete: if false;
    }

    // 連番カウンター。フィードバック送信のトランザクションが get して +1 する。
    // 任意の値への書き換えと、カウンター以外のドキュメントは拒否。
    match /fst_feedback_meta/{docId} {
      allow get: if isVerifiedAccount() && docId == 'counter';
      allow list: if false;
      allow create: if isVerifiedAccount()
        && docId == 'counter'
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if isVerifiedAccount()
        && docId == 'counter'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // App Dashboard: 閲覧は公開・追加/編集/削除/評価は hihaho 編集者（Googleログイン）のみ
    match /apps/{id} {
      allow read: if true;
      allow write: if isHihahoEditor();
    }

    // ともえホーム: 子ども向けホームのアプリ一覧
    // index.html は tomoe-home/config を onSnapshot（get）するだけ（ログイン不要）。
    // 書き込みは編集者の Google ログインだけ。文書IDが固定なので、未ログインの上書きは拒否する。
    match /tomoe-home/{docId} {
      allow get: if docId == 'config';
      allow list: if false;
      allow create, update: if docId == 'config'
        && isHihahoEditor()
        && request.resource.data.keys().hasOnly(['apps'])
        && request.resource.data.apps is list
        && request.resource.data.apps.size() <= 50;
      allow delete: if false;
    }

    // おうち巴寿司: 家族コードを知っている人同士で音声・画像を共有
    // ouchi-hamasushi/{familyCode}/assets/{assetKey}
    // assetKey は voice_otousan_まぐろ / image_avatar_okasan などの形式
    function ouchiWriter(familyCode) {
      return isHihahoEditor() && familyCode.size() >= 1 && familyCode.size() <= 64
        || (isVerifiedAccount() && familyCode.matches('^[A-Za-z0-9_-]{16,64}$'));
    }
    match /ouchi-hamasushi/{familyCode}/assets/{assetKey} {
      allow read: if true;
      // data URI 1件 <= 950KB、mimeType/size/updatedAt のみ受け付け
      // 書き込み・削除は、編集者か、確認済みログインかつ16文字以上の家族コードだけ。
      // 再生（read）は家族コードを知る端末のまま。初期コード tomoe3030 は編集者だけが変更できる。
      allow create, update: if
        ouchiWriter(familyCode) &&
        assetKey.matches('^(voice|image)_.{1,200}$') &&
        request.resource.data.keys().hasOnly(['data','mimeType','size','updatedAt']) &&
        request.resource.data.data is string &&
        request.resource.data.data.size() <= 950000;
      allow delete: if
        ouchiWriter(familyCode) &&
        assetKey.matches('^(voice|image)_.{1,200}$');
    }
    // note-analytics: 個人分析ツール（Googleログイン必須・本人 uid のパスのみ）
    // note-analytics/{uid}/snapshots/{YYYYMMDD}
    match /note-analytics/{userId}/snapshots/{weekId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId &&
        weekId.matches('^[0-9]{8}$') &&
        request.resource.data.keys().hasOnly(['weekStart','views','likes','followers','comments','articles','source','createdAt','updatedAt']) &&
        request.resource.data.weekStart is string && request.resource.data.weekStart.size() == 10 &&
        request.resource.data.views is number &&
        request.resource.data.likes is number &&
        request.resource.data.followers is number &&
        request.resource.data.comments is number &&
        (!('articles' in request.resource.data) || request.resource.data.articles is number) &&
        request.resource.data.source in ['manual', 'screenshot', 'chrome-auto', 'migrated'];
      // 旧 userId 方式時代のデータ移行用: 編集者（オーナー）は読み取りのみ可
      allow read: if isHihahoEditor();
    }

    // COCO-ITTA: 家族グループ。Google ログイン後にだけ触る。
    // グループIDを知っているだけの人は参加できない。参加申請を出し、作成者（createdBy）が
    // role:member を1人だけ足す。メンバーは pins / routes / memberNames / routeSettings だけ更新できる。
    // members を変えられるのは次の3つだけ。作成者が member を1人足す、作成者が member を1人外す、
    // member 本人が自分だけ抜ける。createdBy と管理者（role:owner）は外せない。
    function isGroupOwner() {
      return isVerifiedAccount()
        && resource.data.createdBy == request.auth.token.email;
    }
    function isKnownGroupMember() {
      return isVerifiedAccount()
        && resource.data.members is list
        && (
          resource.data.members.hasAny([{'email': request.auth.token.email, 'role': 'owner'}])
          || resource.data.members.hasAny([{'email': request.auth.token.email, 'role': 'member'}])
        );
    }
    function canReadGroup() {
      return isGroupOwner() || isKnownGroupMember();
    }
    // 作成者が招待・承認で member を1人追加する。所有者の枠は残し、role:owner は増やさない。
    function ownerAddsMember() {
      return isGroupOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'lastInviteEmail'])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.lastInviteEmail is string
        && request.resource.data.lastInviteEmail.size() > 3
        && request.resource.data.lastInviteEmail.size() <= 320
        && request.resource.data.members is list
        && resource.data.members is list
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.hasAll(resource.data.members)
        && !resource.data.members.hasAny([{'email': request.resource.data.lastInviteEmail, 'role': 'member'}])
        && !resource.data.members.hasAny([{'email': request.resource.data.lastInviteEmail, 'role': 'owner'}])
        && request.resource.data.members.hasAny([{'email': request.resource.data.lastInviteEmail, 'role': 'member'}])
        && request.resource.data.members.hasAny([{'email': resource.data.createdBy, 'role': 'owner'}]);
    }
    function groupContentUpdate() {
      return canReadGroup()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['pins', 'routes', 'memberNames', 'routeSettings']);
    }
    // 1人だけ外す。新しい members は元の部分集合で、createdBy の owner は残す。他のフィールドは変えない。
    function groupMemberRemoval() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.members is list
        && resource.data.members is list
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && resource.data.members.hasAll(request.resource.data.members)
        && request.resource.data.members.hasAny([{'email': resource.data.createdBy, 'role': 'owner'}]);
    }
    function ownerRemovesMember() {
      return isGroupOwner() && groupMemberRemoval();
    }
    function memberLeavesSelf() {
      return isVerifiedAccount()
        && request.auth.token.email != resource.data.createdBy
        && resource.data.members.hasAny([{'email': request.auth.token.email, 'role': 'member'}])
        && !request.resource.data.members.hasAny([{'email': request.auth.token.email, 'role': 'member'}])
        && !request.resource.data.members.hasAny([{'email': request.auth.token.email, 'role': 'owner'}])
        && groupMemberRemoval();
    }
    function isOwnerOfGroup(groupId) {
      return isVerifiedAccount()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.token.email;
    }
    match /groups/{groupId} {
      allow get: if canReadGroup();
      allow list: if false;
      allow create: if isVerifiedAccount()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 300
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0].email == request.auth.token.email
        && request.resource.data.members[0].role == 'owner';
      allow update: if groupContentUpdate() || ownerAddsMember() || ownerRemovesMember() || memberLeavesSelf();
      allow delete: if false;

      // 参加申請。申請者は自分の文書だけ作れて読める。承認（status）は作成者だけ。
      match /joinRequests/{uid} {
        allow create: if isVerifiedAccount()
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/groups/$(groupId))
          && request.resource.data.keys().hasOnly(['email', 'status', 'createdAt'])
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.email.size() > 3
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow get: if isVerifiedAccount() && (
          request.auth.uid == uid || isOwnerOfGroup(groupId)
        );
        allow list: if isOwnerOfGroup(groupId);
        allow update: if isOwnerOfGroup(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'approved'
          && request.resource.data.email == resource.data.email;
        allow delete: if isOwnerOfGroup(groupId);
      }
    }

    // BOMBING BAY: 匿名ランキング＆プレイログ（認証なし・作成のみ・改ざん不可）
    // bombing-bay/global/plays/{id}   … 1プレイ=1ドキュメント
    // bombing-bay/global/players/{pid} … 1端末=1ドキュメント（人数カウント用）
    match /bombing-bay/global/plays/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['pid','name','map','score','destroyed','timeSec','result','startedAt','ua','endedAt']) &&
        request.resource.data.pid is string && request.resource.data.pid.size() <= 32 &&
        request.resource.data.name is string && request.resource.data.name.size() <= 10 &&
        request.resource.data.map is string && request.resource.data.map.size() <= 12 &&
        request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score < 1000000 &&
        request.resource.data.timeSec is number && request.resource.data.timeSec >= 0 && request.resource.data.timeSec < 36000 &&
        request.resource.data.result in ['clear', 'over'];
      allow update, delete: if false;
    }
    match /bombing-bay/global/players/{pid} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['createdAt', 'ua']);
      allow update, delete: if false;
    }

    // ともえプレイヤー: YouTube 動画リスト共有（最大100本）
    // 子どもはログインせず doc(listId).get() で読んで再生する。コレクション一覧は取らない。
    // 書き込み（videos / name）は保護者の確認済み Google ログイン（isHihahoEditor）だけ。
    // リスト文書の削除はクライアントがしない。
    match /tomoe-player/{listId} {
      allow get: if listId.size() >= 1 && listId.size() <= 12;
      allow list: if false;
      allow create, update: if
        isHihahoEditor() &&
        listId.size() >= 1 && listId.size() <= 12 &&
        request.resource.data.keys().hasOnly(['videos','sources','updatedAt','name']) &&
        request.resource.data.videos is list &&
        request.resource.data.videos.size() <= 100;
      allow delete: if false;

      // 視聴ログ: 1再生=1ドキュメント。作成・更新は書いた端末の uid、削除は本人か編集者。
      // 一覧は保護者（編集者）だけ。共有コードを知る未ログインの list は拒否する。
      // 1件の get は保護者か、そのログを書いた端末だけ。
      match /sessions/{sessionId} {
        allow get: if isHihahoEditor()
          || (request.auth != null && resource.data.uid == request.auth.uid);
        allow list: if isHihahoEditor();
        // 作成・更新は、その再生を書いた端末の uid だけ。更新時に uid を差し替えて乗っ取れるようにしない。
        // 削除は本人か編集者（stats.html は Google ログインした編集者）。
        allow create: if sessionOwnedFields();
        allow update: if resource.data.uid == request.auth.uid && sessionOwnedFields();
        allow delete: if
          listId.matches('^[A-Za-z0-9_-]{1,12}$') &&
          sessionId.matches('^[a-z0-9]{4,24}$') &&
          (isHihahoEditor() || (request.auth != null && resource.data.uid == request.auth.uid));
      }
    }
    function sessionOwnedFields() {
      return request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['videoId','title','startedAt','day','dow','hour','watchSec','maxPos','duration','completed','endReason','endedAt','device','startReason','uid']) &&
        request.resource.data.videoId is string && request.resource.data.videoId.size() <= 20 &&
        request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
        request.resource.data.startedAt is string && request.resource.data.startedAt.size() <= 40 &&
        request.resource.data.day is string && request.resource.data.day.size() == 10 &&
        request.resource.data.dow is number && request.resource.data.dow >= 0 && request.resource.data.dow <= 6 &&
        request.resource.data.hour is number && request.resource.data.hour >= 0 && request.resource.data.hour <= 23 &&
        request.resource.data.watchSec is number && request.resource.data.watchSec >= 0 && request.resource.data.watchSec <= 86400 &&
        request.resource.data.completed is bool;
    }

    // hihaho アナリティクス: プレイリスト表示・動画再生カウント
    // 認証なしで書けるのは「カウント +1 と最終日時（サーバー時刻）」のみ。削除・任意値の上書きは不可
    match /playlist_analytics/{id} {
      allow read: if true;
      allow create, update: if
        exists(/databases/$(database)/documents/playlists/$(id)) &&
        request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['viewCount', 'lastViewed']) &&
        request.resource.data.viewCount == (resource == null ? 0 : resource.data.get('viewCount', 0)) + 1 &&
        request.resource.data.lastViewed == request.time;
      allow delete: if isHihahoEditor();
    }
    match /video_analytics/{uuid} {
      allow read: if true;
      allow create, update: if
        uuid.size() <= 64 &&
        request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['playCount', 'lastPlayed', 'videoId', 'playlists']) &&
        request.resource.data.playCount == (resource == null ? 0 : resource.data.get('playCount', 0)) + 1 &&
        request.resource.data.lastPlayed == request.time &&
        (!('videoId' in request.resource.data) || request.resource.data.videoId == null ||
          (request.resource.data.videoId is string && request.resource.data.videoId.size() <= 64)) &&
        // playlists: { プレイリストID: 再生回数 }。1回の書き込みで変わるのは1件まで
        (!('playlists' in request.resource.data) || (
          request.resource.data.playlists is map &&
          request.resource.data.playlists.size() <= 500 &&
          request.resource.data.playlists.diff(resource == null ? {} : resource.data.get('playlists', {})).affectedKeys().size() <= 1
        ));
      allow delete: if isHihahoEditor();
    }

    // Meet Knowledge: チームコードを知っている人同士でQ&Aナレッジを共有
    // meet-knowledge/{teamCode}/entries/{entryId}
    match /meet-knowledge/{teamCode}/entries/{entryId} {
      allow read: if true;
      // 書き込み・削除は、編集者か、確認済みログインかつ16文字以上のチームコードだけ。
      // 既定の default は編集者だけが変更できる。読み取りは会議画面のため公開のまま。
      allow create, update: if
        meetWriter(teamCode) &&
        request.resource.data.keys().hasOnly(['question','answer','keywords','category','createdAt','updatedAt','hits','source']) &&
        request.resource.data.question is string && request.resource.data.question.size() <= 500 &&
        request.resource.data.answer is string && request.resource.data.answer.size() <= 5000 &&
        request.resource.data.keywords is list && request.resource.data.keywords.size() <= 20;
      allow delete: if
        meetWriter(teamCode) &&
        entryId.size() >= 1 && entryId.size() <= 64;
    }
    function meetWriter(teamCode) {
      return isHihahoEditor() && teamCode.matches('^[A-Za-z0-9_-]{1,64}$')
        || (isVerifiedAccount() && teamCode.matches('^[A-Za-z0-9_-]{16,64}$'));
    }

    // hihaho ナレッジベース
    // audience: 'public' は誰でも読める / 'internal' は編集者のみ
    // 編集者 = @splineglobal.com ドメイン or 許可リストのGoogleアカウント
    function isKbEditor() {
      return isHihahoEditor();
    }
    match /hihaho-kb/{docId} {
      allow read: if resource.data.audience == 'public' || isKbEditor();
      allow create, update: if isKbEditor() &&
        request.resource.data.audience in ['public', 'internal'] &&
        request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
        request.resource.data.body is string && request.resource.data.body.size() <= 100000;
      allow delete: if isKbEditor();
    }

    // hihaho 素材ライブラリ（iFrame素材・3Dモデルのカタログ）
    // 読み取りは公開（Chrome拡張がREST APIで一覧取得する）・書き込みは編集者のみ
    match /hihaho-material/{docId} {
      allow read: if true;
      allow create, update: if isKbEditor() &&
        request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
        request.resource.data.type in ['html', 'zip', 'glb'] &&
        request.resource.data.tags is list && request.resource.data.tags.size() <= 20;
      allow delete: if isKbEditor();
    }

    // 明友社向け見積もりシミュレーター: 単価設定は許可アカウントのみ読める・書き込みは管理者のみ（Admin/REST経由）
    // 編集者メールは email_verified 必須。専用パスワードアカウントは、画面が
    // signInWithEmailAndPassword だけで、メール未確認のまま使っている可能性があるため確認を要求しない。
    // 残リスク: meiyusha@meiyusha-estimate.app を未確認のまま名乗れるのは、そのアカウントが未作成のときだけ。
    match /meiyusha-estimate/{docId} {
      allow read: if request.auth != null && request.auth.token.email is string && (
        request.auth.token.email == 'meiyusha@meiyusha-estimate.app' ||
        (request.auth.token.email_verified == true && (
          request.auth.token.email.matches('.*@splineglobal[.]com') ||
          request.auth.token.email == 'junpei.omote@gmail.com'
        ))
      );
      allow write: if false;
    }

    // hondoko (本ドコ？): 蔵書管理
    // 編集 = メンバー(オーナー + hondoko-config/members)のみ
    // 閲覧 = メンバー + 公開設定(hondoko-config/sharing)に応じたビューワー
    function isHondokoOwner() {
      return isVerifiedAccount() && request.auth.token.email == 'junpei.omote@gmail.com';
    }
    function isHondokoMember() {
      return isVerifiedAccount() && (
        isHondokoOwner() ||
        (exists(/databases/$(database)/documents/hondoko-config/members) &&
         request.auth.token.email in get(/databases/$(database)/documents/hondoko-config/members).data.emails)
      );
    }
    function hondokoSharing() {
      return get(/databases/$(database)/documents/hondoko-config/sharing).data;
    }
    // 閲覧者メールは hondoko-config/viewers が正。旧 sharing.viewers も、移し終わるまで本の閲覧判定に使う。
    // get() はルール評価の中なので、閲覧者文書をクライアントに読ませずに照合できる。
    function isListedHondokoViewer(sharing) {
      let viewerDoc = exists(/databases/$(database)/documents/hondoko-config/viewers)
        ? get(/databases/$(database)/documents/hondoko-config/viewers).data
        : {};
      let currentViewers = viewerDoc.get('emails', []);
      let legacyViewers = sharing.get('viewers', []);
      return isVerifiedAccount() && (
        (currentViewers is list && request.auth.token.email in currentViewers)
        || (legacyViewers is list && request.auth.token.email in legacyViewers)
      );
    }
    // 本番の共有リンクは https://cc-dev-ps7.web.app/hondoko/?k=<鍵>。
    // 鍵は Math.random().toString(36).slice(2,10)+同.slice(2,6) で、通常12文字の [0-9a-z]。
    // 保存先は hondoko-config/sharing の linkKey。移行後は hondoko-config/link の key（同じ文字列）。
    // どちらかに一致するセッションだけが link モードの蔵書を読める。mode=='link' だけでは読めない。
    function storedLinkKey() {
      let fromLink = exists(/databases/$(database)/documents/hondoko-config/link)
        ? get(/databases/$(database)/documents/hondoko-config/link).data.get('key', '')
        : '';
      return fromLink is string && fromLink.size() >= 8
        ? fromLink
        : hondokoSharing().get('linkKey', '');
    }
    function hasValidLinkSession() {
      return request.auth != null
        && exists(/databases/$(database)/documents/hondoko-link-sessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/hondoko-link-sessions/$(request.auth.uid)).data.key is string
        && get(/databases/$(database)/documents/hondoko-link-sessions/$(request.auth.uid)).data.key.size() >= 8
        && get(/databases/$(database)/documents/hondoko-link-sessions/$(request.auth.uid)).data.key == storedLinkKey();
    }
    function isHondokoViewer() {
      // public はログイン不要。viewers は確認済みメールがリストにあるときだけ。
      // link は、URL の鍵で作ったセッションが保存済みの鍵と一致するときだけ。
      let sharing = exists(/databases/$(database)/documents/hondoko-config/sharing)
        ? hondokoSharing()
        : {};
      return sharing.mode == 'public'
        || (sharing.mode == 'viewers' && isListedHondokoViewer(sharing))
        || (sharing.mode == 'link' && hasValidLinkSession());
    }
    // メールもリンク鍵も、未ログインの共有設定には載せない。
    function sharingIsPublicSafe() {
      return (!('viewers' in resource.data)
          || (resource.data.viewers is list && resource.data.viewers.size() == 0))
        && !('linkKey' in resource.data);
    }
    function canHondokoRead() {
      return isHondokoMember() || isHondokoViewer();
    }
    match /hondoko-config/members {
      allow read: if isHondokoMember();
      allow write: if isHondokoOwner();
    }
    match /hondoko-config/viewers {
      // 閲覧者のメール一覧。読めるのは家族メンバー（オーナーを含む）だけ。閲覧者本人と未ログインは不可。
      allow read: if isHondokoMember();
      allow create, update: if isHondokoOwner()
        && request.resource.data.keys().hasOnly(['emails'])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 200;
      allow delete: if false;
    }
    match /hondoko-config/link {
      // 共有リンクの鍵。読めるのは家族だけ。未ログインには渡さない。
      allow read: if isHondokoMember();
      allow create, update: if isHondokoOwner()
        && request.resource.data.keys().hasOnly(['key'])
        && request.resource.data.key is string
        && request.resource.data.key.matches('^[A-Za-z0-9_-]{8,128}$');
      allow delete: if false;
    }
    match /hondoko-link-sessions/{uid} {
      // ゲストが URL の鍵を提示する場所。一覧は禁止。鍵の値は保存済みの鍵と一致するときだけ書ける。
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/hondoko-config/sharing)
        && hondokoSharing().mode == 'link'
        && request.resource.data.keys().hasOnly(['key'])
        && request.resource.data.key is string
        && request.resource.data.key.size() >= 8
        && request.resource.data.key.size() <= 128
        && request.resource.data.key == storedLinkKey();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /hondoko-config/sharing {
      // mode と allowComments だけ。viewers や linkKey があるとメンバー以外は読めない。
      allow read: if isHondokoMember() || sharingIsPublicSafe();
      allow create, update: if isHondokoOwner()
        && request.resource.data.keys().hasOnly(['mode', 'allowComments'])
        && request.resource.data.mode in ['private', 'viewers', 'link', 'public']
        && request.resource.data.allowComments is bool;
      allow delete: if false;
    }
    match /hondoko-shelves/{docId} {
      allow read: if canHondokoRead();
      allow write: if isHondokoMember();
    }
    match /hondoko-books/{docId} {
      allow read: if canHondokoRead();
      allow write: if isHondokoMember();
    }
    match /hondoko-photos/{docId} {
      allow read: if canHondokoRead();
      allow write: if isHondokoMember();
    }
    match /hondoko-maps/{docId} {
      allow read: if canHondokoRead();
      allow write: if isHondokoMember();
    }
    // ユーザーごとの評価・メモ(相互に閲覧可、書き込みは本人のみ)
    match /hondoko-reviews/{docId} {
      allow read: if canHondokoRead();
      allow create, update: if isVerifiedAccount()
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.rating is int
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 2000
        && (isHondokoMember() ||
            (isHondokoViewer() && hondokoSharing().allowComments == true));
      allow delete: if isHondokoOwner() ||
        (isVerifiedAccount() && resource.data.by == request.auth.token.email);
    }
    match /hondoko-comments/{docId} {
      allow read: if canHondokoRead();
      allow create: if isVerifiedAccount()
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && (isHondokoMember() ||
            (isHondokoViewer() && hondokoSharing().allowComments == true));
      allow update: if false;
      allow delete: if isHondokoOwner() ||
        (isVerifiedAccount() && resource.data.by == request.auth.token.email);
    }

    // outreach-crm: 確認済みログインと、24文字以上のランダムなワークスペースコードが両方必要。
    // クライアントは doc(code).get() / onSnapshot / set({leads, updatedAt: Date.now()}) だけ。
    // コードを知っていても未ログインでは読めない。短いコード（移行前の任意文字列）は拒否。
    // 残リスク: ログイン済みで、その24文字以上のコードを知っている人は、その1件を読めて同じ形で上書きできる。
    match /outreach-crm/{workspaceCode} {
      allow get: if isVerifiedAccount()
                 && workspaceCode.matches('^[A-Za-z0-9_-]{24,128}$');
      allow list: if false;
      allow create, update: if isVerifiedAccount()
                   && workspaceCode.matches('^[A-Za-z0-9_-]{24,128}$')
                   && request.resource.data.keys().hasOnly(['leads','updatedAt'])
                   && request.resource.data.leads is list
                   && request.resource.data.leads.size() <= 20000
                   && request.resource.data.updatedAt is int;
      allow delete: if false;
    }

    // その他は全拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
