rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 共有データは確認済みのログインと accessGrants が必要。共有コードだけでは通さない。
    // プラットフォーム管理者はカスタムクレーム admin=true、または Admin SDK だけが書ける admins/{uid}。
    // UID をルールへ直書きしない。手順は docs/admin-access.md。
    function verifiedAccount() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isPlatformAdmin() {
      return verifiedAccount() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function canShare(scope, write) {
      let path = /databases/$(database)/documents/accessGrants/$(scope);
      return verifiedAccount() && (isPlatformAdmin() ||
        (exists(path) && get(path).data.enabled == true &&
         get(path).data.expiresAt > request.time &&
         (request.auth.uid in get(path).data.writers ||
          (!write && request.auth.uid in get(path).data.readers))));
    }
    match /admins/{uid} {
      allow read, write: if false;
    }
    match /accessGrants/{scope} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    function isHihahoEditor() {
      return verifiedAccount() && (
        request.auth.token.email.matches('.*@splineglobal[.]com') ||
        request.auth.token.email == 'junpei.omote@gmail.com'
      );
    }
    function prevData() {
      return resource == null ? {} : resource.data;
    }
    function changedKeys() {
      return request.resource.data.diff(prevData()).affectedKeys();
    }
    function isCount(v) {
      return v is number && v >= 0 && v < 10000000000;
    }

    match /playlists/{id} {
      allow read: if true;
      allow write: if isHihahoEditor();
    }
    match /video_meta/{id} {
      allow read: if true;
      allow write: if isHihahoEditor();
    }

    match /users/{userId}/{document=**} {
      allow read, write: if verifiedAccount() && request.auth.uid == userId;
    }
    function fstAnalyticsOk(d) {
      return d.keys().hasOnly(['uidHash','date','month','hour','dow','version','build','createdAt','device','type'])
        && d.keys().hasAll(['uidHash','date','version','build','createdAt'])
        && d.uidHash is string && d.uidHash.size() > 0 && d.uidHash.size() <= 32
        && d.date is string && d.date.size() == 10
        && d.version is string && d.version.size() <= 40
        && d.build is string && d.build.size() <= 20
        && d.createdAt == request.time
        && (!d.keys().hasAny(['type']) || d.type in ['session', 'task_created', 'task_completed'])
        && (!d.keys().hasAny(['month']) || (d.month is string && d.month.size() == 7))
        && (!d.keys().hasAny(['hour']) || (d.hour is int && d.hour >= 0 && d.hour <= 23))
        && (!d.keys().hasAny(['dow']) || (d.dow is int && d.dow >= 0 && d.dow <= 6))
        && (!d.keys().hasAny(['device']) || (d.device is string && d.device.size() <= 20));
    }
    match /fst_analytics/{docId} {
      allow read: if isHihahoEditor();
      allow create: if verifiedAccount() && fstAnalyticsOk(request.resource.data);
      allow update, delete: if isHihahoEditor();
    }
    // 目安箱は Cloud Functions だけが書く。クライアントの作成・更新・削除は拒否する。
    // 読み取りは確認済みの編集者、または自分の uid の文書だけ。
    match /fst_feedback/{docId} {
      allow read: if isHihahoEditor() || (verifiedAccount() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /fst_feedback_meta/{docId} {
      allow read, write: if false;
    }
    match /fst_feedback_limits/{docId} {
      allow read, write: if false;
    }

    function appFieldsOk(d, ch) {
      return d.keys().hasOnly(['name','type','version','status','url','icon','env','releaseNote','docs','rating','updatedAt'])
        && (!ch.hasAny(['name'])        || (d.name is string && d.name.size() > 0 && d.name.size() <= 200))
        && (!ch.hasAny(['type'])        || (d.type is string && d.type.size() <= 20))
        && (!ch.hasAny(['version'])     || (d.version is string && d.version.size() <= 50))
        && (!ch.hasAny(['status'])      || (d.status is string && d.status.size() <= 20))
        && (!ch.hasAny(['url'])         || (d.url is string && d.url.size() <= 2000))
        && (!ch.hasAny(['icon'])        || (d.icon is string && d.icon.size() <= 2000))
        && (!ch.hasAny(['env'])         || (d.env is list && d.env.size() <= 30))
        && (!ch.hasAny(['releaseNote']) || (d.releaseNote is string && d.releaseNote.size() <= 50000))
        && (!ch.hasAny(['docs'])        || (d.docs is list && d.docs.size() <= 50))
        && (!ch.hasAny(['rating'])      || (d.rating is int && d.rating >= 0 && d.rating <= 5))
        && (!ch.hasAny(['updatedAt'])   || d.updatedAt == request.time);
    }
    match /apps/{id} {
      allow read: if canShare('apps__registry', false);
      allow create: if canShare('apps__registry', true)
        && request.resource.data.keys().hasAll(['name','updatedAt'])
        && appFieldsOk(request.resource.data, changedKeys());
      allow update: if canShare('apps__registry', true)
        && appFieldsOk(request.resource.data, changedKeys());
      allow delete: if canShare('apps__registry', true);
    }

    match /tomoe-home/{docId} {
      allow read: if canShare('tomoe-home__' + docId, false);
      allow write: if canShare('tomoe-home__' + docId, true) &&
        request.resource.data.keys().hasOnly(['apps']) &&
        request.resource.data.apps is list &&
        request.resource.data.apps.size() <= 50;
    }

    function isOuchiAssetPath(familyCode, assetKey) {
      return familyCode.size() <= 64
        && assetKey.size() <= 200
        && assetKey.matches('(voice|image)_.+');
    }
    match /ouchi-hamasushi/{familyCode}/assets/{assetKey} {
      allow read: if canShare('ouchi-hamasushi__' + familyCode, false);
      allow create, update: if canShare('ouchi-hamasushi__' + familyCode, true)
        && isOuchiAssetPath(familyCode, assetKey)
        && request.resource.data.keys().hasOnly(['data','mimeType','size','updatedAt'])
        && request.resource.data.keys().hasAll(['data','mimeType','size','updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 950000
        && request.resource.data.mimeType is string
        && request.resource.data.mimeType.size() <= 100
        && request.resource.data.size is int
        && request.resource.data.size >= 0
        && request.resource.data.size <= 950000
        && request.resource.data.updatedAt == request.time;
      allow delete: if canShare('ouchi-hamasushi__' + familyCode, true)
        && isOuchiAssetPath(familyCode, assetKey);
    }

    match /note-analytics/{userId}/{document=**} {
      allow read: if canShare('note-analytics__' + userId, false);
      allow write: if false;
    }
    function noteSnapshotOk(d, ch, snapId) {
      return ch.hasOnly(['weekStart','views','likes','followers','comments','articles','source','createdAt','updatedAt'])
        && d.weekStart is string
        && d.weekStart.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.weekStart.replace('-', '') == snapId
        && (!ch.hasAny(['views'])     || isCount(d.views))
        && (!ch.hasAny(['likes'])     || isCount(d.likes))
        && (!ch.hasAny(['followers']) || isCount(d.followers))
        && (!ch.hasAny(['comments'])  || isCount(d.comments))
        && (!ch.hasAny(['articles'])  || isCount(d.articles))
        && (!ch.hasAny(['source'])    || d.source in ['manual', 'screenshot', 'chrome-auto'])
        && (!ch.hasAny(['createdAt']) || d.createdAt == request.time)
        && (!ch.hasAny(['updatedAt']) || d.updatedAt == request.time);
    }
    match /note-analytics/{userId}/snapshots/{snapId} {
      allow read: if canShare('note-analytics__' + userId, false);
      allow create, update: if canShare('note-analytics__' + userId, true)
        && userId.size() <= 100
        && snapId.matches('[0-9]{8}')
        && noteSnapshotOk(request.resource.data, changedKeys(), snapId);
      allow delete: if canShare('note-analytics__' + userId, true)
        && snapId.matches('[0-9]{8}');
    }

    function cocoRole(email, role) {
      return {'email': email, 'role': role};
    }
    function cocoIsMember(data) {
      return data.keys().hasAny(['members']) && data.members is list && data.members.hasAny([
        cocoRole(request.auth.token.email, 'owner'),
        cocoRole(request.auth.token.email, 'member')
      ]);
    }
    match /groups/{groupId} {
      allow get: if verifiedAccount();
      allow list: if false;
      allow create: if verifiedAccount()
        && request.resource.data.createdBy == request.auth.token.email
        && cocoIsMember(request.resource.data)
        && request.resource.data.members.hasAny([cocoRole(request.auth.token.email, 'owner')]);
      allow update: if verifiedAccount() && (
        cocoIsMember(resource.data) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
         && request.resource.data.members.hasAll(resource.data.members)
         && request.resource.data.members.size() == resource.data.members.size() + 1
         && request.resource.data.members.hasAny([cocoRole(request.auth.token.email, 'member')]))
      );
      allow delete: if verifiedAccount()
        && resource.data.members.hasAny([cocoRole(request.auth.token.email, 'owner')]);
    }

    match /bombing-bay/global/plays/{id} {
      allow read: if canShare('bombing-bay__global', false);
      allow create: if canShare('bombing-bay__global', true) &&
        request.resource.data.keys().hasOnly(['pid','name','map','score','destroyed','timeSec','result','startedAt','ua','endedAt']) &&
        request.resource.data.pid is string && request.resource.data.pid.size() <= 32 &&
        request.resource.data.name is string && request.resource.data.name.size() <= 10 &&
        request.resource.data.map is string && request.resource.data.map.size() <= 12 &&
        request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score < 1000000 &&
        request.resource.data.timeSec is number && request.resource.data.timeSec >= 0 && request.resource.data.timeSec < 36000 &&
        request.resource.data.result in ['clear', 'over'];
      allow update, delete: if false;
    }
    match /bombing-bay/global/players/{pid} {
      allow read: if canShare('bombing-bay__global', false);
      allow create: if canShare('bombing-bay__global', true) && request.resource.data.keys().hasOnly(['createdAt', 'ua']);
      allow update, delete: if false;
    }

    match /tomoe-player/{listId} {
      allow read: if canShare('tomoe-player__' + listId, false);
      allow write: if canShare('tomoe-player__' + listId, true) &&
        request.resource.data.keys().hasOnly(['videos','sources','updatedAt','name']) &&
        request.resource.data.videos is list &&
        request.resource.data.videos.size() <= 100;
      match /sessions/{sessionId} {
        allow read: if canShare('tomoe-player__' + listId, false);
        allow create, update: if canShare('tomoe-player__' + listId, true) &&
          request.resource.data.keys().hasOnly(['videoId','title','startedAt','day','dow','hour','watchSec','maxPos','duration','completed','endReason','endedAt','device','startReason']) &&
          request.resource.data.videoId is string && request.resource.data.videoId.size() <= 20 &&
          request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
          request.resource.data.startedAt is string && request.resource.data.startedAt.size() <= 40 &&
          request.resource.data.day is string && request.resource.data.day.size() == 10 &&
          request.resource.data.dow is number && request.resource.data.dow >= 0 && request.resource.data.dow <= 6 &&
          request.resource.data.hour is number && request.resource.data.hour >= 0 && request.resource.data.hour <= 23 &&
          request.resource.data.watchSec is number && request.resource.data.watchSec >= 0 && request.resource.data.watchSec <= 86400 &&
          request.resource.data.completed is bool;
        allow delete: if canShare('tomoe-player__' + listId, true);
      }
    }

    match /playlist_analytics/{id} {
      allow read: if canShare('hihaho-analytics__global', false) || isHihahoEditor();
      allow create: if canShare('hihaho-analytics__global', true)
        && request.resource.data.keys().hasOnly(['viewCount','lastViewed'])
        && request.resource.data.viewCount == 1
        && request.resource.data.lastViewed == request.time
        && exists(/databases/$(database)/documents/playlists/$(id));
      allow update: if canShare('hihaho-analytics__global', true)
        && changedKeys().hasOnly(['viewCount','lastViewed'])
        && request.resource.data.viewCount == resource.data.viewCount + 1
        && request.resource.data.lastViewed == request.time;
      allow delete: if isHihahoEditor();
    }

    function vaHas(pk, ex, lo, hi) {
      return lo < pk.size() && ex.hasAny(pk[lo:(hi < pk.size() ? hi : pk.size())]);
    }
    function vaFind1(pk, ex, lo, nd, od) {
      return vaHas(pk, ex, lo, lo + 1)
        && pk[lo] != 'playCount' && pk[lo] != 'lastPlayed' && pk[lo] != 'videoId'
        && nd[pk[lo]] == od[pk[lo]] + 1;
    }
    function vaFind2(pk, ex, lo, nd, od) {
      return vaHas(pk, ex, lo, lo + 1) ? vaFind1(pk, ex, lo, nd, od) : vaFind1(pk, ex, lo + 1, nd, od);
    }
    function vaFind4(pk, ex, lo, nd, od) {
      return vaHas(pk, ex, lo, lo + 2) ? vaFind2(pk, ex, lo, nd, od) : vaFind2(pk, ex, lo + 2, nd, od);
    }
    function vaFind8(pk, ex, lo, nd, od) {
      return vaHas(pk, ex, lo, lo + 4) ? vaFind4(pk, ex, lo, nd, od) : vaFind4(pk, ex, lo + 4, nd, od);
    }
    function vaFind16(pk, ex, lo, nd, od) {
      return vaHas(pk, ex, lo, lo + 8) ? vaFind8(pk, ex, lo, nd, od) : vaFind8(pk, ex, lo + 8, nd, od);
    }
    function vaFind32(pk, ex, lo, nd, od) {
      return vaHas(pk, ex, lo, lo + 16) ? vaFind16(pk, ex, lo, nd, od) : vaFind16(pk, ex, lo + 16, nd, od);
    }
    function vaFind64(pk, ex, lo, nd, od) {
      return vaHas(pk, ex, lo, lo + 32) ? vaFind32(pk, ex, lo, nd, od) : vaFind32(pk, ex, lo + 32, nd, od);
    }
    function vaFind128(pk, ex, nd, od) {
      return pk.size() <= 128
        && (vaHas(pk, ex, 0, 64) ? vaFind64(pk, ex, 0, nd, od) : vaFind64(pk, ex, 64, nd, od));
    }
    function videoAnalyticsOk(uuid, d, prev) {
      let extra = d.diff(prev).affectedKeys().difference(['playCount', 'lastPlayed', 'videoId'].toSet());
      let added = d.keys().removeAll(prev.keys()).removeAll(['playCount', 'lastPlayed', 'videoId']);
      return uuid.matches('[0-9A-Fa-f-]{8,64}')
        && d.keys().hasAll(['playCount', 'lastPlayed', 'videoId'])
        && d.keys().size() <= 128
        && d.playCount == prev.get('playCount', 0) + 1
        && d.lastPlayed == request.time
        && (d.videoId is int || (d.videoId is string && d.videoId.size() <= 40))
        && d.videoId == prev.get('videoId', d.videoId)
        && extra.size() <= 1
        && (extra.size() == 0
            || (added.size() == 1
                && added[0].matches('playlists[.][A-Za-z0-9_-]{1,64}')
                && d[added[0]] == 1)
            || (added.size() == 0 && vaFind128(prev.keys(), extra, d, prev)));
    }
    match /video_analytics/{uuid} {
      allow read: if canShare('hihaho-analytics__global', false) || isHihahoEditor();
      allow create, update: if canShare('hihaho-analytics__global', true)
        && videoAnalyticsOk(uuid, request.resource.data, prevData());
      allow delete: if isHihahoEditor();
    }

    match /meet-knowledge/{teamCode}/entries/{entryId} {
      allow read: if canShare('meet-knowledge__' + teamCode, false);
      allow create, update: if canShare('meet-knowledge__' + teamCode, true) &&
        request.resource.data.keys().hasOnly(['question','answer','keywords','category','createdAt','updatedAt','hits','source']) &&
        request.resource.data.question is string && request.resource.data.question.size() <= 500 &&
        request.resource.data.answer is string && request.resource.data.answer.size() <= 5000 &&
        request.resource.data.keywords is list && request.resource.data.keywords.size() <= 20;
      allow delete: if canShare('meet-knowledge__' + teamCode, true);
    }

    // hihaho ナレッジベース
    // audience: 'public' は誰でも読める / 'internal' は編集者のみ
    // 編集者 = @splineglobal.com ドメイン or 許可リストのGoogleアカウント
    function isKbEditor() {
      return isHihahoEditor();
    }
    match /hihaho-kb/{docId} {
      allow read: if resource.data.audience == 'public' || isKbEditor();
      allow create, update: if isKbEditor() &&
        request.resource.data.audience in ['public', 'internal'] &&
        request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
        request.resource.data.body is string && request.resource.data.body.size() <= 100000;
      allow delete: if isKbEditor();
    }

    // hihaho 素材ライブラリ（iFrame素材・3Dモデルのカタログ）
    // 読み取りは公開（Chrome拡張がREST APIで一覧取得する）・書き込みは編集者のみ
    match /hihaho-material/{docId} {
      allow read: if true;
      allow create, update: if isKbEditor() &&
        request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
        request.resource.data.type in ['html', 'zip', 'glb'] &&
        request.resource.data.tags is list && request.resource.data.tags.size() <= 20;
      allow delete: if isKbEditor();
    }

    // 明友社向け見積もりシミュレーター: 単価設定は許可アカウントのみ読める・書き込みは管理者のみ（Admin/REST経由）
    match /meiyusha-estimate/{docId} {
      allow read: if verifiedAccount() && (
        request.auth.token.email == 'meiyusha@meiyusha-estimate.app' ||
        request.auth.token.email.matches('.*@splineglobal[.]com') ||
        request.auth.token.email == 'junpei.omote@gmail.com'
      );
      allow write: if false;
    }

    // hondoko (本ドコ？): 蔵書管理
    // 編集 = メンバー(オーナー + hondoko-config/members)のみ
    // 閲覧 = メンバー + 公開設定(hondoko-config/sharing)に応じたビューワー
    function isHondokoOwner() {
      return verifiedAccount() && request.auth.token.email == 'junpei.omote@gmail.com';
    }
    function isHondokoMember() {
      return verifiedAccount() && (
        isHondokoOwner() ||
        (exists(/databases/$(database)/documents/hondoko-config/members) &&
         request.auth.token.email in get(/databases/$(database)/documents/hondoko-config/members).data.emails)
      );
    }
    function hondokoSharing() {
      return get(/databases/$(database)/documents/hondoko-config/sharing).data;
    }
    function isHondokoViewer() {
      // link/public はログイン不要で閲覧可。viewers はログイン+リスト登録が必要
      return exists(/databases/$(database)/documents/hondoko-config/sharing) && (
        hondokoSharing().mode == 'public' ||
        hondokoSharing().mode == 'link' ||
        (verifiedAccount() &&
         hondokoSharing().mode == 'viewers' &&
         request.auth.token.email in hondokoSharing().viewers)
      );
    }
    function canHondokoRead() {
      return isHondokoMember() || isHondokoViewer();
    }
    match /hondoko-config/members {
      allow read: if isHondokoMember();
      allow write: if isHondokoOwner();
    }
    match /hondoko-config/sharing {
      // ゲスト判定のため誰でも読める(link/publicの未ログイン閲覧に必要。
      // viewers のメールアドレス一覧を含むため注意して運用)
      allow read: if true;
      allow write: if isHondokoOwner();
    }
    match /hondoko-shelves/{docId} {
      allow read: if canHondokoRead();
      allow write: if isHondokoMember();
    }
    match /hondoko-books/{docId} {
      allow read: if canHondokoRead();
      allow write: if isHondokoMember();
    }
    match /hondoko-photos/{docId} {
      allow read: if canHondokoRead();
      allow write: if isHondokoMember();
    }
    match /hondoko-maps/{docId} {
      allow read: if canHondokoRead();
      allow write: if isHondokoMember();
    }
    // ユーザーごとの評価・メモ(相互に閲覧可、書き込みは本人のみ)
    match /hondoko-reviews/{docId} {
      allow read: if canHondokoRead();
      allow create, update: if verifiedAccount()
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.rating is int
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 2000
        && (isHondokoMember() ||
            (isHondokoViewer() && hondokoSharing().allowComments == true));
      allow delete: if isHondokoOwner() ||
        (verifiedAccount() && resource.data.by == request.auth.token.email);
    }
    match /hondoko-comments/{docId} {
      allow read: if canHondokoRead();
      allow create: if verifiedAccount()
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && (isHondokoMember() ||
            (isHondokoViewer() && hondokoSharing().allowComments == true));
      allow update: if false;
      allow delete: if isHondokoOwner() ||
        (verifiedAccount() && resource.data.by == request.auth.token.email);
    }

    // outreach-crm: ワークスペースコードを知っている端末間でリード/成約データを共有
    // outreach-crm/{workspaceCode} 単一ドキュメントに leads 配列を保持
    match /outreach-crm/{workspaceCode} {
      allow read: if canShare('outreach-crm__' + workspaceCode, false);
      allow write: if canShare('outreach-crm__' + workspaceCode, true) && request.resource.data.keys().hasOnly(['leads','updatedAt'])
                   && request.resource.data.leads is list
                   && request.resource.data.leads.size() <= 20000;
    }

    // その他は全拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
