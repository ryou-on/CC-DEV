{
  "Name": "AI Usage Monitor",
  "Version": "0.1.0.0",
  "Author": "CC-DEV",
  "Description": "Claude Code / Codex / ChatGPT の使用率をキーに表示",
  "Icon": "icons/plugin",
  "CodePath": "app.html",
  "SDKVersion": 2,
  "Software": { "MinimumVersion": "6.4" },
  "OS": [{ "Platform": "mac", "MinimumVersion": "11" }, { "Platform": "windows", "MinimumVersion": "10" }],
  "Actions": [
    { "Name": "Claude Code 使用率", "UUID": "com.ccdev.aiusage.claude", "Icon": "icons/claude", "Tooltip": "Claude Code の使用率", "States": [{ "Image": "icons/claude" }] },
    { "Name": "Codex 使用率", "UUID": "com.ccdev.aiusage.codex", "Icon": "icons/codex", "Tooltip": "Codex の使用率", "States": [{ "Image": "icons/codex" }] },
    { "Name": "ChatGPT 使用率（押すと+1）", "UUID": "com.ccdev.aiusage.chatgpt", "Icon": "icons/chatgpt", "Tooltip": "ChatGPT の使用率。キーを押すと +1 カウント", "States": [{ "Image": "icons/chatgpt" }] }
  ]
}
