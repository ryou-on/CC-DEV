{
  "manifest_version": 3,
  "name": "X Fullscreen Reader",
  "version": "0.2.2",
  "description": "Xのタイムラインを1記事1画面の大きな文字で読む全画面リーダー（←→で送り、↑↓でブックマーク）",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
