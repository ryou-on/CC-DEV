{
  "manifest_version": 3,
  "name": "Kindle Owned Badge",
  "version": "0.6.0",
  "description": "Amazon.co.jpの商品サムネイルに、購入済み・Kindle Unlimited利用済みの「済」バッジを表示します",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.amazon.co.jp/*",
    "https://read.amazon.co.jp/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.amazon.co.jp/*"],
      "js": ["content/amazon-badge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://read.amazon.co.jp/*"],
      "js": ["content/library-sync.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Kindle Owned Badge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
