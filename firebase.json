{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/realtime-token",
        "function": {
          "functionId": "realtimeToken",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/api/interpreter-call",
        "function": {
          "functionId": "interpreterCall",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/api/mini-me-generate",
        "function": {
          "functionId": "miniMeGenerate",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/api/mini-me-checkout",
        "function": {
          "functionId": "miniMeCheckout",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/api/mini-me-webhook",
        "function": {
          "functionId": "miniMeWebhook",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/e/**",
        "function": {
          "functionId": "assetServe",
          "region": "asia-northeast1"
        }
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
