{
  "firestore": {
    "rules": "firestore.rules",
    "predeploy": [
      "python3 \"$PROJECT_DIR/scripts/cost_guard.py\" --root \"$PROJECT_DIR\" --check"
    ]
  },
  "storage": {
    "rules": "storage.rules",
    "predeploy": [
      "python3 \"$PROJECT_DIR/scripts/cost_guard.py\" --root \"$PROJECT_DIR\" --check"
    ]
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "python3 \"$PROJECT_DIR/scripts/cost_guard.py\" --root \"$PROJECT_DIR\" --check"
    ]
  },
  "hosting": [
    {
      "target": "main",
      "public": "public",
      "predeploy": [
        "python3 \"$PROJECT_DIR/scripts/cost_guard.py\" --root \"$PROJECT_DIR\" --check"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "cm-generator/**",
        "sylavids-cm/**"
      ],
      "rewrites": [
        {
          "source": "/api/realtime-token",
          "function": {
            "functionId": "realtimeToken",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/interpreter-call",
          "function": {
            "functionId": "interpreterCall",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/mini-me-generate",
          "function": {
            "functionId": "miniMeGenerate",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/mini-me-checkout",
          "function": {
            "functionId": "miniMeCheckout",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/mini-me-webhook",
          "function": {
            "functionId": "miniMeWebhook",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/hondoko-analyze",
          "function": {
            "functionId": "hondokoAnalyze",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/e/**",
          "function": {
            "functionId": "assetServe",
            "region": "asia-northeast1"
          }
        }
      ],
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "target": "ps7-corporate",
      "public": "public/ps7-corporate",
      "predeploy": [
        "python3 \"$PROJECT_DIR/scripts/cost_guard.py\" --root \"$PROJECT_DIR\" --check"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "target": "lobby-personal",
      "public": "public/lobby-personal",
      "predeploy": [
        "python3 \"$PROJECT_DIR/scripts/cost_guard.py\" --root \"$PROJECT_DIR\" --check"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    }
  ]
}
