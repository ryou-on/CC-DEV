# サーバー専用。VITE_接頭辞を秘密情報につけない。
APP_MODE=local
PORT=8080
OPENAI_API_KEY=
JEV_API_KEY=
JEV_MODEL=jev-latest
GOOGLE_CLOUD_PROJECT=cc-dev-ps7
# 本番: APP_MODE=cloud。Cloud Runのサービスアカウント/Secret Managerを利用。
# ローカルでクラウド結合確認時のみADC等を設定。
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/service-account.json
# 以下は公開可能なFirebase Web設定。未設定ならローカルUI。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cc-dev-ps7.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cc-dev-ps7
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=

# Cloud Run URL。本番では必須（Hosting経由は60秒制限のため使用しない）。
VITE_API_BASE_URL=
# OCR用の学習データ。npm run setup:ocr で .ocr-data/ に取得できます。
# OCR_TESSDATA_DIR=/absolute/path/to/tessdata
