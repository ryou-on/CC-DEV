// 結合時は既存Rulesに追加し、重複するallowルールがないことを確認する。
// FirestoreはallowのOR評価。下のdenyだけでは既存の包括allowを打ち消せない。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /speechUsers/{document=**} { allow read, write: if false; }
    match /speechLimits/{document=**} { allow read, write: if false; }
    match /speechVisits/{document=**} { allow read, write: if false; }
    match /apps/{document=**} { allow read, write: if false; }
    match /changelog/{document=**} { allow read, write: if false; }
    match /analytics/{document=**} { allow read, write: if false; }
    match /feedback/{document=**} { allow read, write: if false; }
  }
}
