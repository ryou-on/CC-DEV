{
  "name": "speech-dashboard",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "registry": "node --env-file-if-exists=.env scripts/registry.js",
    "setup:ocr": "node scripts/setup-ocr.js"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "firebase": "^12.0.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "firebase-admin": "^13.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@playwright/test": "^1.55.0"
  }
}
