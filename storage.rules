rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // COCO-ITTA: グループの写真はメンバー（認証済みユーザー）のみ読み書き可
    match /groups/{groupId}/pins/{pinId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // hihaho サムネイル: 読み取り公開・書き込み公開（管理画面から認証なしでアップロード）
    match /hihaho-thumbs/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // hihaho 素材ライブラリ: 読み取り公開（配信はFunctions経由だがサムネ等の直参照も許可）
    // 書き込みは編集者アカウントのみ・1ファイル30MBまで
    match /hihaho-material/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.token.email.matches('.*@splineglobal[.]com')
                       || request.auth.token.email == 'junpei.omote@gmail.com')
                   && (request.resource == null || request.resource.size < 30 * 1024 * 1024);
    }

    // hondoko (本ドコ？): 棚写真 — 読み取り公開(link/公開モードの未ログイン閲覧のため。
    // 写真URLはFirestoreの公開設定と連動できないため常時公開になる点に注意)
    // 書き込みは認証ユーザー・画像のみ・10MBまで(メンバー判定はFirestore側で担保)
    match /hondoko/{sub}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.resource == null ||
                       (request.resource.size < 10 * 1024 * 1024
                        && request.resource.contentType.matches('image/.*')));
    }

    // その他は全拒否
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
