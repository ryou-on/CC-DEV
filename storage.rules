rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function verifiedAccount() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // COCO-ITTA: 匿名サインインは拒否。パスを知る確認済みアカウントが読み書きできる。
    // Storage ルールから Firestore の members は参照しない。
    match /groups/{groupId}/pins/{pinId}/{allPaths=**} {
      allow read: if verifiedAccount();
      allow write: if verifiedAccount()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 編集者のメールは functions/editor-policy.json が正本。Rules は import できない。
    // メールは大文字小文字を区別しない。Functions の trim + lower と同じ結果になるよう、ここで揃える。
    function isHihahoEditor() {
      return verifiedAccount()
          && (request.auth.token.email.trim().lower().matches('.*@splineglobal[.]com')
              || request.auth.token.email.trim().lower() == 'junpei.omote@gmail.com');
    }

    // hihaho サムネイル: 読み取り公開・書き込みは編集者のみ（hihaho-admin からGoogleログイン後にアップロード）
    match /hihaho-thumbs/{allPaths=**} {
      allow read: if true;
      allow write: if isHihahoEditor()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // hihaho プレイリストのロゴ画像: 読み取り公開・書き込みは編集者のみ・画像2MBまで
    // （hihaho-admin の uploadLogoFile が logos/ に保存。従来はルール未定義で全拒否だった）
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if isHihahoEditor()
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // hihaho 素材ライブラリ: 読み取り公開（配信はFunctions経由だがサムネ等の直参照も許可）
    // 書き込みは編集者アカウントのみ・1ファイル30MBまで
    match /hihaho-material/{allPaths=**} {
      allow read: if true;
      allow write: if isHihahoEditor()
                   && (request.resource == null || request.resource.size < 30 * 1024 * 1024);
    }

    // hondoko (本ドコ？): 棚写真 — 読み取り公開(link/公開モードの未ログイン閲覧のため。
    // 写真URLはFirestoreの公開設定と連動できないため常時公開になる点に注意)
    // 書き込みは確認済みアカウント・画像のみ・10MBまで(メンバー判定はFirestore側で担保)
    match /hondoko/{sub}/{allPaths=**} {
      allow read: if true;
      allow write: if verifiedAccount()
                   && (request.resource == null ||
                       (request.resource.size < 10 * 1024 * 1024
                        && request.resource.contentType.matches('image/.*')));
    }

    // その他は全拒否
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
